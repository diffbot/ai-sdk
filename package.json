{
  "name": "@diffbot/ai-sdk",
  "version": "0.1.0-dev.0",
  "description": "Diffbot tools for the Vercel AI SDK — web search, extract, and Knowledge Graph (DQL)",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:peer:ai6": "pnpm add -D ai@6 @ai-sdk/openai-compatible@2 && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@diffbot/typescript": "^0.3.0"
  },
  "peerDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.0 || ^3.0.0",
    "ai": "^6.0.0 || ^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai-compatible": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.15.21",
    "ai": "^7.0.0",
    "eslint": "^9.20.0",
    "jiti": "^2.7.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.2.1",
    "zod": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shixish/diffbot-ai-sdk.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
