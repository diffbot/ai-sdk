# Copy to `examples/.env` and fill in. Never commit the filled-in file.
#
# Run an example with it loaded:
#   node --env-file-if-exists=examples/.env examples/company-research/index.ts "…"

# Required by every example (https://app.diffbot.com/get-started/).
DIFFBOT_API_TOKEN=

# The agent/answer model. `EXAMPLE_MODEL` is any AI SDK model string; the
# default (`anthropic/claude-sonnet-5`) routes through the Vercel AI Gateway,
# which reads AI_GATEWAY_API_KEY. The Workers example needs neither: it answers
# with Diffbot's own RAG model via `@diffbot/ai-sdk/provider`.
AI_GATEWAY_API_KEY=
# EXAMPLE_MODEL=anthropic/claude-sonnet-5

# Only if you swap the gateway for a direct provider package, e.g.
# `pnpm add @ai-sdk/anthropic` and `model: anthropic("claude-sonnet-5")`.
ANTHROPIC_API_KEY=
